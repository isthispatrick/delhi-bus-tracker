  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "prepare-data": "node scripts/prepare-data.js",
    "prepare-reclaim": "node scripts/prepare-reclaim.js",
    "prepare-metro": "node scripts/prepare-metro.js",
    "prepare-planner": "node scripts/prepare-planner.js",
    "check-planner": "node scripts/check-planner.js"
  },
  "dependencies": {
